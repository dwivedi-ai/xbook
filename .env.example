# Copy to .env and fill in. Then: chmod 600 .env
#
# To find these values:
#   1. Open x.com in a browser, logged in.
#   2. DevTools -> Application -> Cookies -> https://x.com
#   3. Copy the `auth_token` and `ct0` values.
#
# WARNING: auth_token is equivalent to a logged-in session.
# Treat it like a password. Never commit .env to git.

X_AUTH_TOKEN=
X_CT0=
