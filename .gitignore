bookmarks.json
bookmarks_*.json

# Spike diagnostic output (contains your real tweets)
spike_raw_response.json

# Internal docs (ADRs, hypothesis-critique) — kept locally, not shipped
docs/

# IDE
.idea/
.vscode/
*.swp
